IMAGE_TAG=main
VOCONED_DIR=/app/run
VOCONED_PORT=9090
VOCONED_URLPATH=/v2
VOCONED_BLOCKPERIOD=5
VOCONED_BLOCKSIZE=2000
VOCONED_LOGLEVEL=debug
VOCONED_CHAINID=dev
VOCONED_TXCOSTS=2
VOCONED_SETTXCOSTS=true
# faucet: amount handed out per claim, and faucet account balance at genesis
VOCONED_ENABLEFAUCETWITHAMOUNT=50
# VOCONED_FAUCETBALANCE=1000000
# keys are generated on first start and saved in $VOCONED_DIR/voconed.yml if not set
# VOCONED_KEYMANAGER=<hex private key>
# VOCONED_FAUCETKEY=<hex private key>
# admin API endpoints are disabled unless a token is set
# VOCONED_ADMINTOKEN=<random secret>
